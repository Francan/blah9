    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main",
            "type": "debugpy",
            "request": "launch",
            "program": "src/blah9/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1",
            }
        },
        {
            "name": "Debug kg_generator",
            "type": "debugpy",
            "request": "launch",
            "program": "src/blah9/kg_generator.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1",
            }
        },
    ]
}